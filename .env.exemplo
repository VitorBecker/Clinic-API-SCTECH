# Porta da API
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost

# Segredo usado para assinar/validar o Token JWT
# Em produção, use um valor longo, aleatório e secreto (nunca versionar!)
JWT_SECRET=uma-chave-bem-secreta-troque-isso
JWT_EXPIRES_IN=1d

PG_HOST=localhost
PG_PORT=5432
PG_TIME_OUT_MS=5000
PG_DATABASE=bookstore_sctec
PG_USER=username
PG_PASSWORD=password